{
  "name": "tailrace-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Agent data governance: in-process detection, reversible tokenization, and per-agent data-flow policy.",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:workers": "pnpm --filter @tailrace/core --filter @tailrace/eve --filter @tailrace/cloud test:workers",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "bench": "pnpm --filter @tailrace/benchmarks bench",
    "size": "pnpm --filter @tailrace/core size",
    "changeset": "changeset",
    "release": "changeset publish",
    "prepare": "husky"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ],
    "overrides": {
      "postcss": ">=8.5.18",
      "js-yaml@5": "5.2.2",
      "find-my-way": ">=9.7.0",
      "sharp": ">=0.35.0",
      "fast-uri": ">=4.1.2",
      "undici": "^7.28.0",
      "vite": "^6.4.3",
      "devalue": ">=5.3.2",
      "ws": ">=8.21.0",
      "brace-expansion@5": ">=5.0.8"
    },
    "auditConfig": {
      "ignoreCves": [
        "CVE-2026-8769"
      ],
      "ignoreGhsas": [
        "GHSA-866g-f22w-33x8"
      ]
    }
  },
  "lint-staged": {
    "*.{js,ts,mjs,cjs}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,mdx,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.11",
    "@eslint/js": "^9.17.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.17.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^3.2.7"
  }
}
